{
  "name": "tiendadiana-backend",
  "version": "1.0.0",
  "description": "API REST para Sistema de Tienda de Ropa de Dama y POS (Preparado para Ecommerce)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/config/init-db.js",
    "db:migrate": "node src/config/migrate-db.js",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1"
