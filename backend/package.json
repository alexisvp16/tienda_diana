    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.3"
  }
}
